# Copy this file to .env and replace the placeholders. Never commit .env.
# .env values override inherited environment variables for this launch only.
# Use NAME=value. Optional surrounding quotes are removed; shell syntax is not executed.
# Do not put inline comments after a value.

# MySQL must already be installed and running; mysql.exe must be on PATH.
# The SQL migrations currently require the database name nothing_router.
DB_URL=jdbc:mysql://localhost:3306/nothing_router?characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Administrator credential, not the chat API key issued by the application.
ROUTER_ADMIN_KEY=change-me-admin-key

DEEPSEEK_API_KEY=change-me
ARK_API_KEY=change-me
