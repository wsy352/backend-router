<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lingrui.router.mapper.RouterUserMapper">

    <insert id="insert"
            parameterType="com.lingrui.router.entity.RouterUser"
            useGeneratedKeys = "true"
            keyProperty = "id">
        INSERT INTO router_user (
                                 username,
                                 status,
                                 created_at,
                                 updated_at
        ) VALUES (
                  #{username},
                  #{status},
                  #{createdAt},
                  #{updatedAt}
                         )
    </insert>

    <select id="selectById"
            resultType="com.lingrui.router.entity.RouterUser">
        SELECT
            id,
            username,
            status,
            created_at AS createdAt,
            updated_at AS updatedAt
        FROM router_user WHERE id = #{id}
    </select>

</mapper>